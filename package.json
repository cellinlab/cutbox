{
  "name": "cutbox",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "description": "Local-first film annotation and reusable media collections",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "desktop": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "node tests/desktop.e2e.mjs",
    "check": "npm run build && npm test && python3 scripts/check_template.py --project",
    "test:desktop:expansion": "node tests/desktop-expansion.e2e.mjs",
    "test:desktop:all": "npm run test:desktop && npm run test:desktop:expansion && npm run test:desktop:story",
    "test:desktop:story": "node tests/story.e2e.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "^1.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^6.0.0",
    "vite": "8.3.4",
    "electron": "44.7.2",
    "playwright": "1.64.1"
  }
}
